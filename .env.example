# Core
DATABASE_URL=postgres://scraper:scraper@db:5432/scraper?sslmode=disable
ADMIN_TOKEN=replace-with-a-long-random-admin-token
API_ADDR=:8080
RETENTION_DAYS=60

# Primary worker
WORKER_ID=xeon-primary-1
WORKER_CONCURRENCY=6
WORKER_POLL_INTERVAL=500ms
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE=1s
WORKER_HEARTBEAT_INTERVAL=20s
WORKER_STALE_AFTER=90s
BROWSER_WORKER_URL=http://browser-worker:3000
BROWSER_REQUEST_TIMEOUT=45s

# Extraction worker: HTTP first, Chromium fallback
BROWSER_PORT=3000
BROWSER_CONCURRENCY=4
BROWSER_NAV_TIMEOUT_MS=30000
BROWSER_BLOCK_IMAGES=true
HTTP_FAST_PATH=true
HTTP_FAST_TIMEOUT_MS=12000
MAX_HTML_BYTES=8388608
SCRAPER_USER_AGENT=

# Polite upstream pressure controls. These spread starts and cap concurrent retailer interactions.
AMAZON_MIN_INTERVAL_MS=350
ALIEXPRESS_MIN_INTERVAL_MS=300
EBAY_MIN_INTERVAL_MS=200
REQUEST_JITTER_MS=100
AMAZON_MAX_CONCURRENT=4
ALIEXPRESS_MAX_CONCURRENT=2
EBAY_MAX_CONCURRENT=3

# PostgreSQL / storage
POSTGRES_USER=scraper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scraper
SCRAPER_DATA_DIR=./data/postgres
POSTGRES_BIND_IP=127.0.0.1

# Cloudflare Tunnel. Keep this secret.
TUNNEL_TOKEN=
